# Copiar como .env dentro de server. No subir las credenciales a Git.
# Formato Java properties: no encerrar los valores entre comillas.
PRIMERPASO_BD_URL=jdbc:postgresql://localhost:5432/PrimerPaso
PRIMERPASO_BD_USUARIO=postgres
PRIMERPASO_BD_CLAVE=

# Usar true cuando la aplicación se sirva mediante HTTPS.
PRIMERPASO_COOKIE_SEGURA=false
